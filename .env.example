# Database
DATABASE_URL="""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# MODO DE ACESSO GRATUITO (Opcional)
# ============================================
# Quando true: TODOS os usuários têm acesso PREMIUM
# Quando false: Respeita planos normais (FREE, BASIC, PRO, PREMIUM)
# Útil para: Lançamentos, testes de mercado, promoções temporárias
ENABLE_FREE_ACCESS_MODE=false

# Data de término do modo gratuito (opcional)
# Formato: YYYY-MM-DD (ex: 2025-12-31)
# Se não definido, o modo gratuito fica ativo indefinidamente
FREE_ACCESS_END_DATE=

# ============================================
# EMAILS (Resend)
# ============================================
# API key do Resend para envio de emails
RESEND_API_KEY=your-resend-api-key

# ============================================
# CRON JOBS (Vercel)
# ============================================
# Secret para autenticar chamadas de cron jobs
# Gerar com: openssl rand -base64 32
CRON_SECRET=your-random-secret-key

# ============================================
# STRIPE (LEGADO — mantido apenas para webhooks de assinaturas existentes)
# Remover quando todos os assinantes migrarem para Asaas
# ============================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY não é mais necessário (checkout agora é Asaas)

# ============================================
# ASAAS (gateway principal — PIX + boleto + cartão)
# ============================================
# API Key: Minha Conta → Integrações → API Key
ASAAS_API_KEY=your-asaas-api-key
# Sandbox URL (opcional, default: sandbox.asaas.com/api/v3)
ASAAS_SANDBOX_URL=https://sandbox.asaas.com/api/v3
# Token do webhook: Configure em Minha Conta → Integrações → Webhooks
# URL do webhook: https://simulaioab.com/api/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=your-webhook-access-token

# ============================================
# OPENAI (IA para explicações e chat)
# ============================================
OPENAI_API_KEY=sk-...
AI_EXPLANATION_MODEL=gpt-4o-mini
# Orçamento mensal em USD (bloqueia chamadas ao atingir)
OPENAI_MONTHLY_BUDGET_USD=50

# ============================================
# CLERK (autenticação)
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ============================================
# UPSTASH REDIS (rate limiting)
# ============================================
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
