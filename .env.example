# Database
DATABASE_URL="postgresql://user:password@host:5432/simulai_oab"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# MODO DE ACESSO GRATUITO (Opcional)
# ============================================
# Quando true: TODOS os usuários têm acesso PREMIUM
# Quando false: Respeita planos normais (FREE, BASIC, PRO, PREMIUM)
# Útil para: Lançamentos, testes de mercado, promoções temporárias
ENABLE_FREE_ACCESS_MODE=false
