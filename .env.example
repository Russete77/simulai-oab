# Database
DATABASE_URL="""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# MODO DE ACESSO GRATUITO (Opcional)
# ============================================
# Quando true: TODOS os usuários têm acesso PREMIUM
# Quando false: Respeita planos normais (FREE, BASIC, PRO, PREMIUM)
# Útil para: Lançamentos, testes de mercado, promoções temporárias
ENABLE_FREE_ACCESS_MODE=false

# Data de término do modo gratuito (opcional)
# Formato: YYYY-MM-DD (ex: 2025-12-31)
# Se não definido, o modo gratuito fica ativo indefinidamente
FREE_ACCESS_END_DATE=

# ============================================
# EMAILS (Resend)
# ============================================
# API key do Resend para envio de emails
RESEND_API_KEY=your-resend-api-key

# ============================================
# CRON JOBS (Vercel)
# ============================================
# Secret para autenticar chamadas de cron jobs
# Gerar com: openssl rand -base64 32
CRON_SECRET=your-random-secret-key

# ============================================
# STRIPE (gateway de pagamento — plano unico R$ 9,99/mes, so cartao)
# Chaves no painel: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Segredo do endpoint https://simulaioab.com/api/webhooks/stripe
# Local: rode `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...
# ID do Price recorrente de R$ 9,99/mes criado no painel
STRIPE_PRICE_ID=price_...

# Teto diario de explicacoes com IA por usuario (default: 20)
DAILY_AI_EXPLANATIONS_LIMIT=20

# ASAAS (LEGADO — so recebe webhook de quem ainda nao migrou pro Stripe).
# Pode remover quando o ultimo ciclo pago vencer.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ============================================
# OPENAI (IA para explicações e chat)
# ============================================
OPENAI_API_KEY=sk-...
AI_EXPLANATION_MODEL=gpt-4o-mini
# Orçamento mensal em USD (bloqueia chamadas ao atingir)
OPENAI_MONTHLY_BUDGET_USD=50

# ============================================
# CLERK (autenticação)
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ============================================
# UPSTASH REDIS (rate limiting)
# ============================================
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
