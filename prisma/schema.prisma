// Simulai OAB - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Subject {
  ETHICS
  CONSTITUTIONAL
  CIVIL
  CIVIL_PROCEDURE
  CRIMINAL
  CRIMINAL_PROCEDURE
  LABOUR
  LABOUR_PROCEDURE
  ADMINISTRATIVE
  TAXES
  BUSINESS
  CONSUMER
  ENVIRONMENTAL
  CHILDREN
  INTERNATIONAL
  HUMAN_RIGHTS
  GENERAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum SimulationType {
  FULL_EXAM
  ADAPTIVE
  QUICK_PRACTICE
  ERROR_REVIEW
  BY_SUBJECT
}

/// Desafio de simulado entre amigos. Antes vivia num Map em memória (resetava
/// a cada redeploy/restart) — agora persistido. `participants` fica em JSON
/// (lista pequena, sem necessidade de tabela própria) em vez de uma tabela
/// relacional separada, dado o volume baixo esperado dessa feature.
model FriendChallenge {
  id          String         @id @default(cuid())
  code        String         @unique
  type        SimulationType
  creatorId   String
  creatorName String
  createdAt   DateTime       @default(now())

  /// Array de { userId, name, score?, completed }
  participants Json

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

enum SimulationStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PlanType {
  FREE
  BASIC
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CARD
  BOLETO
  APPLE_PAY
  GOOGLE_PAY
  CASH_APP_PAY
  ACH_DEBIT
  PIX
  OTHER
}

// Planos válidos: BASIC_MONTHLY (R$19,99) e PRO_MONTHLY (R$89,99)
// Subscription.plan é String para compatibilidade — validação feita no app

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  clerkId   String?  @unique
  planType  PlanType @default(BASIC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Controle de limites de uso (reset diário/mensal)
  dailyQuestionsCount        Int       @default(0)
  dailyQuestionsResetAt      DateTime?
  monthlySimulationsCount    Int       @default(0)
  monthlySimulationsResetAt  DateTime?
  dailyAiExplanationsCount   Int       @default(0)
  dailyAiExplanationsResetAt DateTime?
  dailyAiChatsCount          Int       @default(0)
  dailyAiChatsResetAt        DateTime?

  // Métricas agregadas (denormalizadas p/ admin dashboards sem scan caro)
  lastActiveAt        DateTime? // último heartbeat confirmado no app
  totalSessionMinutes Int       @default(0)
  totalLogins         Int       @default(0)

  // Atribuição de aquisição — first-touch UTM capturado no primeiro acesso
  // (cookie), persistido uma vez após o cadastro. Sem isso não dava pra
  // saber de onde veio um cadastro se rodasse mídia paga.
  acquisitionUtm Json?

  // Relations
  answers                UserAnswer[]
  simulations            Simulation[]
  profile                UserProfile?
  achievements           UserAchievement[]
  studyPlans             StudyPlan[]
  chatSessions           UserQuestionChat[]
  customer               Customer?
  reviewCards            ReviewCard[]
  pushSubscriptions      PushSubscription[]
  sessions               UserSession[]
  emailCampaigns         EmailCampaign[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  friendChallenges       FriendChallenge[]

  @@index([email])
  @@index([clerkId])
  @@index([lastActiveAt])
  @@index([planType])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Gamification
  totalPoints   Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  lastStudyDate DateTime?

  // Stats
  totalQuestions Int    @default(0)
  correctAnswers Int    @default(0)
  averageTime    Float?

  // Study preferences
  dailyGoal         Int       @default(20)
  preferredSubjects Subject[]

  // Onboarding tracking
  onboardingCompleted   Boolean   @default(false)
  onboardingStep        Int       @default(0) // 0=not started, 1-3=steps, 4=completed
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// QUESTIONS & ALTERNATIVES
// ============================================================================

model Question {
  id             String  @id @default(cuid())
  examId         String // "2023-01"
  examYear       Int
  examPhase      Int // 1 ou 2
  questionNumber Int // 1-100
  subject        Subject
  statement      String  @db.Text

  // P3 FIX: explanation DEPRECIADO — usar QuestionExplanation como source of truth
  // Mantido por retrocompatibilidade (fallback se QuestionExplanation não existir)
  explanation String? @db.Text

  // Anulação
  nullified   Boolean   @default(false)
  nullifiedAt DateTime? // P3 FIX: Quando foi anulada
  nullifiedBy String? // P3 FIX: "FGV" | "ADMIN" — quem anulou

  // Metadados calculados
  difficulty  Difficulty?
  averageTime Float?
  successRate Float?

  // Features NLP
  keywords        String[]
  legalReferences Json?

  // Relations
  alternatives        Alternative[]
  userAnswers         UserAnswer[]
  simulationQuestions SimulationQuestion[]
  aiExplanation       QuestionExplanation?
  chatSessions        UserQuestionChat[]
  reviewCards         ReviewCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, questionNumber])
  @@index([examId])
  @@index([subject, difficulty])
  @@index([examYear, examPhase])
}

model Alternative {
  id         String  @id @default(cuid())
  questionId String
  label      String // A, B, C, D
  text       String  @db.Text
  isCorrect  Boolean

  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[]

  @@unique([questionId, label])
  @@index([questionId])
}

// ============================================================================
// USER ANSWERS
// ============================================================================

model UserAnswer {
  id            String  @id @default(cuid())
  userId        String
  questionId    String
  alternativeId String
  simulationId  String?

  isCorrect  Boolean
  timeSpent  Int // segundos
  confidence Int? // 1-5

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  alternative Alternative @relation(fields: [alternativeId], references: [id], onDelete: Cascade)
  simulation  Simulation? @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([questionId])
  @@index([simulationId])
  @@index([userId, isCorrect])
  @@index([userId, createdAt])
  @@index([questionId, isCorrect])
  @@index([userId, questionId]) // P2 FIX: Otimiza queries "questões já respondidas por usuário"
}

// ============================================================================
// SIMULATIONS
// ============================================================================

model Simulation {
  id     String           @id @default(cuid())
  userId String
  type   SimulationType
  status SimulationStatus @default(IN_PROGRESS)

  totalQuestions Int
  score          Float?
  timeSpent      Int? // segundos totais

  // Configuração
  subjects         Subject[]
  targetDifficulty Difficulty?

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions SimulationQuestion[]
  answers   UserAnswer[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model SimulationQuestion {
  id           String @id @default(cuid())
  simulationId String
  questionId   String
  order        Int

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([simulationId, questionId])
  @@index([simulationId])
}

// ============================================================================
// GAMIFICATION
// ============================================================================

model Achievement {
  id          String @id @default(cuid())
  key         String @unique // "FIRST_CORRECT", "STREAK_7", etc
  name        String
  description String
  icon        String
  points      Int

  users UserAchievement[]

  createdAt DateTime @default(now())
}

model UserAchievement {
  id            String @id @default(cuid())
  userId        String
  achievementId String

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  unlockedAt DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

// ============================================================================
// STUDY PLANS
// ============================================================================

model StudyPlan {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?

  targetExamDate DateTime?
  weeklyGoal     Int // questões por semana
  focusSubjects  Subject[]

  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
}

// ============================================================================
// SPACED REPETITION SYSTEM (SRS)
// ============================================================================

model ReviewCard {
  id         String @id @default(cuid())
  userId     String
  questionId String

  // SRS Algorithm fields (SM-2 inspired)
  easeFactor  Float @default(2.5) // Difficulty factor (1.3 - 5.0)
  interval    Int   @default(1) // Days until next review
  repetitions Int   @default(0) // Number of successful reviews

  // Scheduling
  nextReviewAt DateTime  @default(now()) // When to show this card
  lastReviewAt DateTime?

  // Stats
  totalReviews   Int @default(0)
  correctReviews Int @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
  @@index([userId])
}

// ============================================================================
// PUSH NOTIFICATIONS
// ============================================================================

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  endpoint String @unique
  p256dh   String
  auth     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// AI EXPLANATIONS & CHAT
// ============================================================================

model QuestionExplanation {
  id         String @id @default(cuid())
  questionId String @unique

  // Explicação gerada pela IA
  explanation    String  @db.Text
  detailedAnswer String? @db.Text

  // Referências legais identificadas pela IA
  legalReferences Json?

  // Metadados
  generatedBy  String // "openai", "manual"
  model        String? // "gpt-4o-mini"
  qualityScore Float? // 0-1 (baseado em feedback dos usuários)
  usageCount   Int     @default(0)

  // Relação
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model UserQuestionChat {
  id         String @id @default(cuid())
  userId     String
  questionId String

  // Conversa (array de mensagens)
  // P3 FIX: Schema documentado + validação Zod em runtime (ver lib/validations/chat.ts)
  // Formato: [{role: "user"|"assistant", content: string, timestamp: string}]
  messages Json

  // Metadados
  messageCount Int     @default(0)
  lastMessage  String? @db.Text

  // Relações
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

// ============================================================================
// BILLING & PAYMENTS (ASAAS)
// ============================================================================

model Customer {
  id     String @id @default(cuid())
  userId String @unique

  // Um Customer pode ter os dois enquanto durar a migração Asaas → Stripe.
  // `gateway` diz qual é o ativo.
  asaasCustomerId  String? @unique // cus_XXXX no Asaas (legado)
  stripeCustomerId String? @unique // cus_XXXX na Stripe
  gateway          String  @default("stripe") // "stripe" | "asaas"

  // Dados do cliente
  name    String
  email   String
  phone   String?
  cpfCnpj String? // CPF/CNPJ para billing Asaas (obrigatório)

  // Relações
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([asaasCustomerId])
  @@index([stripeCustomerId])
}

model Subscription {
  id                   String  @id @default(cuid())
  customerId           String
  asaasSubscriptionId  String? @unique // sub_XXXX no Asaas (legado)
  stripeSubscriptionId String? @unique // sub_XXXX na Stripe
  gateway              String  @default("stripe") // "stripe" | "asaas"

  // Plano (String para compatibilidade com dados existentes, validação no app)
  plan   String // "BASIC_MONTHLY" ou "PRO_MONTHLY"
  status SubscriptionStatus @default(ACTIVE)

  // Valores
  value    Float // Valor por período
  discount Float? // Desconto aplicado

  // Configuração
  cycle String // "MONTHLY" (único ciclo suportado)

  // Períodos
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  // Trial
  trialStart DateTime?
  trialEnd   DateTime?

  // Datas
  startDate  DateTime  @default(now())
  endDate    DateTime?
  canceledAt DateTime?

  // Relacionamentos
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments Payment[]

  // Metadados
  metadata Json? // Dados extras (cupom, origem, etc)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([asaasSubscriptionId])
  @@index([stripeSubscriptionId])
  @@index([currentPeriodEnd])
}

model Payment {
  id             String  @id @default(cuid())
  customerId     String
  subscriptionId String?

  // ID externo do pagamento no gateway
  externalPaymentId String @unique // ID do pagamento no Asaas (pay_XXXXX)

  // Valores
  value    Float
  netValue Float? // Valor líquido (após taxas)

  // Status e método
  status        PaymentStatus
  paymentMethod PaymentMethod

  // Dados de pagamento
  dueDate       DateTime
  paymentDate   DateTime?
  confirmedDate DateTime?

  // URLs
  receiptUrl String? // URL do recibo
  invoiceUrl String? // URL da fatura

  // Cartão
  creditCardBrand String?
  creditCardLast4 String?

  // Relacionamentos
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Webhooks recebidos
  webhookEvents Json?

  // Metadados
  description       String?
  externalReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@index([externalPaymentId])
}

model WebhookLog {
  id        String  @id @default(cuid())
  eventType String  @default("unknown") // "PAYMENT_RECEIVED", "ai_usage", etc.
  eventId   String? // ID único do evento (para idempotência)
  source    String  @default("asaas") // "asaas" | "system"
  payload   Json // Payload completo do webhook
  processed Boolean @default(false)
  error     String? @db.Text

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([eventType])
  @@index([eventId])
  @@index([source])
  @@index([processed])
  @@index([createdAt])
  @@index([processed, createdAt])
}

// ============================================================================
// TRACKING DE SESSÕES (heartbeat próprio, complementa Clerk)
// Clerk dá login/device/IP; esta tabela registra TEMPO ATIVO real na aba.
// ============================================================================

model UserSession {
  id              String   @id @default(cuid())
  userId          String
  clerkSessionId  String? // cruzar com Clerk SessionWithActivities
  startedAt       DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())
  durationSec     Int      @default(0) // derivado: last - started, cap por idle
  pageViews       Int      @default(0)
  entryPath       String? // primeira rota
  exitPath        String? // última rota
  userAgent       String?
  ipAddress       String?
  country         String?
  city            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startedAt])
  @@index([startedAt])
  @@index([lastHeartbeatAt])
}

// ============================================================================
// CAMPANHAS DE EMAIL (inativos e outros)
// ============================================================================

enum CampaignType {
  INACTIVE_D3
  INACTIVE_D7
  INACTIVE_D14
  WELCOME
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  SUBSCRIPTION_CANCELED
  CUSTOM
}

enum CampaignStatus {
  QUEUED
  SENT
  OPENED
  CLICKED
  BOUNCED
  FAILED
  UNSUBSCRIBED
}

model EmailCampaign {
  id        String         @id @default(cuid())
  userId    String
  type      CampaignType
  status    CampaignStatus @default(QUEUED)
  subject   String
  resendId  String?        @unique // id do envio no Resend (pra pollar status)
  metadata  Json? // utmParams, variant A/B, etc.
  sentAt    DateTime?
  openedAt  DateTime?
  clickedAt DateTime?
  error     String?        @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([type, sentAt])
  @@index([status])
  @@index([resendId])
}

// ============================================================================
// NOTIFICAÇÕES IN-APP + CAMPANHAS MULTICANAL
// Sistema próprio (não 3rd-party) que coordena push + email + in-app + vibrate.
// ============================================================================

enum NotificationType {
  INFO
  ALERT
  ACHIEVEMENT
  REMINDER
  PAYMENT_RECOVERY
  PROMO
  CAMPAIGN
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELED
}

/// Caixa de entrada por usuário. Toda notificação enviada vira uma row aqui,
/// independente do canal (push/email/in-app). Permite UI de "central de notificações".
model Notification {
  id       String               @id @default(cuid())
  userId   String
  type     NotificationType
  priority NotificationPriority @default(NORMAL)

  // Conteúdo
  title       String
  body        String  @db.Text
  iconUrl     String?
  imageUrl    String?
  actionUrl   String? // URL pra onde clique leva
  actionLabel String? // texto do botão

  // Status do user
  readAt      DateTime?
  dismissedAt DateTime?

  // Tracking de entrega multicanal
  channels        NotificationChannel[] // canais alvo configurados
  inAppDelivered  Boolean   @default(true) // sempre disponível na inbox
  pushSent        Boolean   @default(false)
  pushSentAt      DateTime?
  pushError       String?
  emailSent       Boolean   @default(false)
  emailSentAt     DateTime?
  emailCampaignId String? // FK pra EmailCampaign quando aplicável
  vibrate         Boolean   @default(false) // pediu vibração no client

  // Origem
  campaignId String?
  campaign   NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  metadata  Json?
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([campaignId])
  @@index([type])
}

/// Template de campanha criado pelo admin. Resolve audiência via filter JSON
/// e dispara em batch pra todos os matching users.
model NotificationCampaign {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text

  // Conteúdo do template (suporta {{userName}} etc)
  type             NotificationType
  priority         NotificationPriority  @default(NORMAL)
  channels         NotificationChannel[] // ['IN_APP','PUSH','EMAIL']
  vibrate          Boolean               @default(false)
  titleTemplate    String
  bodyTemplate     String                @db.Text
  iconUrl          String?
  imageUrl         String?
  actionUrl        String?
  actionLabel      String?
  emailSubjectTemplate String?
  emailHtmlTemplate    String? @db.Text

  // Targeting
  audienceFilter Json // { subscriptionStatus: 'NO_SUB', daysSinceSignup: 7, ... }

  // Schedule + state
  status        NotificationCampaignStatus @default(DRAFT)
  scheduledFor  DateTime?
  sentAt        DateTime?
  cancelledAt   DateTime?

  // Stats agregadas (atualizadas no dispatch + leitura)
  totalTargeted Int @default(0)
  totalSent     Int @default(0)
  totalRead     Int @default(0)
  totalClicked  Int @default(0)
  totalFailed   Int @default(0)

  // Recurrence (pra recovery campaigns)
  recurring   Boolean @default(false)
  recurringKey String? @unique // ex: "RECOVERY_D7" — cron usa pra evitar dispatch dup

  createdBy String // adminEmail

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@index([createdBy])
}

/// Preferencias do user sobre canais (opt-in/out por tipo).
/// Default tudo on. In-app sempre fica visivel; user opt-out so de push/email.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)

  promoEnabled       Boolean @default(true)
  reminderEnabled    Boolean @default(true)
  achievementEnabled Boolean @default(true)
  recoveryEnabled    Boolean @default(true)

  quietHoursStart Int?
  quietHoursEnd   Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// AUDIT LOG — ações administrativas para rastreabilidade
// ============================================================================

model AdminAudit {
  id         String  @id @default(cuid())
  adminEmail String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([adminEmail])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
}
